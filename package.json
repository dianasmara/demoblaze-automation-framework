{
  "name": "demoblaze-e2e-framework",
  "version": "1.0.0",
  "description": "E2E Test Automation Framework for DemoBlaze using Playwright + TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:regression": "playwright test tests/regression",
    "test:performance": "playwright test tests/performance",
    "test:headed": "playwright test --headed",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome'",
    "report": "playwright show-report",
    "report:allure": "allure serve allure-results",
    "codegen": "playwright codegen https://www.demoblaze.com",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "eslint": "^9.12.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "allure-playwright": "^3.0.0",
    "allure-commandline": "^2.30.0",
    "dotenv": "^16.4.0"
  },
  "keywords": ["playwright", "typescript", "e2e", "automation", "testing"],
  "author": "QA Engineer",
  "license": "MIT"
}
